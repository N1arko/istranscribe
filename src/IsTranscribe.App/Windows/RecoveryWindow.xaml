<ui:FluentWindow x:Class="IsTranscribe.App.Windows.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:IsTranscribe.App.Strings"
        Title="{loc:Loc Dialog_Recovery_WindowTitle}"
        Height="360"
        Width="640"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{loc:Loc Dialog_Recovery_Title}" />

    <Border Grid.Row="1" Margin="0,20,0,20" Padding="16" Background="{DynamicResource AppWarningBackgroundBrush}" CornerRadius="8">
      <StackPanel>
        <TextBlock x:Name="SummaryText" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="DetailText" Margin="0,12,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Padding="12,8" Content="{loc:Loc Dialog_Recovery_Quit}" Click="OnQuitClick" />
      <ui:Button Appearance="Primary" Margin="12,0,0,0" Padding="12,8" Content="{loc:Loc Dialog_Recovery_OpenApp}" Click="OnOpenAppClick" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
