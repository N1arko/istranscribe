<ui:FluentWindow x:Class="IsTranscribe.App.Windows.ManualApplicationRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:IsTranscribe.App.Strings"
        Title="{loc:Loc Dialog_AddApplication_WindowTitle}"
        Height="220"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{loc:Loc Dialog_AddApplication_Title}" FontSize="18" FontWeight="SemiBold" />

    <StackPanel Grid.Row="1" Margin="0,16,0,0">
      <TextBlock Foreground="{DynamicResource AppTextLabelBrush}" Text="{loc:Loc Dialog_AddApplication_DisplayName_Label}" />
      <TextBox x:Name="DisplayNameTextBox" Margin="0,6,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Foreground="{DynamicResource AppTextLabelBrush}" Text="{loc:Loc Dialog_AddApplication_ProcessName_Label}" />
      <TextBox x:Name="ProcessNameTextBox" Margin="0,6,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Padding="12,6" Content="{loc:Loc Dialog_AddApplication_Cancel}" Click="OnCancelClick" />
      <ui:Button Appearance="Primary" Margin="12,0,0,0" Padding="12,6" Content="{loc:Loc Dialog_AddApplication_Add}" Click="OnAddClick" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
