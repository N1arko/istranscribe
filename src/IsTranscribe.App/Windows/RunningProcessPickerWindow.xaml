<ui:FluentWindow x:Class="IsTranscribe.App.Windows.RunningProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:IsTranscribe.App.Windows"
        xmlns:loc="clr-namespace:IsTranscribe.App.Strings"
        Title="{loc:Loc Dialog_RunningProcessPicker_WindowTitle}"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{loc:Loc Dialog_RunningProcessPicker_Title}" FontSize="18" FontWeight="SemiBold" />

    <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="VerticalOnly">
        <ItemsControl x:Name="ProcessItemsControl">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:SelectableProcessItem}">
              <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="6">
                <DockPanel LastChildFill="True">
                  <CheckBox VerticalAlignment="Top" IsChecked="{Binding IsSelected}" />
                  <StackPanel Margin="12,0,0,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding ProcessName}" />
                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding ActivityLabel}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Padding="12,6" Content="{loc:Loc Dialog_RunningProcessPicker_Cancel}" Click="OnCancelClick" />
      <ui:Button Appearance="Primary" Margin="12,0,0,0" Padding="12,6" Content="{loc:Loc Dialog_RunningProcessPicker_Add}" Click="OnAddClick" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
