<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- @spec spec://modules/platform/INFRA-007-cross-platform-core-and-avalonia-shell#acceptance -->
    <IsReleaseArtifact>false</IsReleaseArtifact>
    <LegacyMigrationFallback>true</LegacyMigrationFallback>
    <!-- @spec spec://modules/platform/INFRA-007-cross-platform-core-and-avalonia-shell#migration -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>IsTranscribe.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IsTranscribe.Host\IsTranscribe.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Strings\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Strings\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
