  <x:String x:Key="String.Transcription.Settings.Title">Cloud transcription</x:String>
  <x:String x:Key="String.Transcription.Settings.Description">Audio chunks are sent to the service you choose when you start transcription or enable automatic transcription. The service may charge your account.</x:String>
  <x:String x:Key="String.Transcription.Settings.Service">Transcription method</x:String>
  <x:String x:Key="String.Transcription.Settings.Service.Generic">the selected service</x:String>
