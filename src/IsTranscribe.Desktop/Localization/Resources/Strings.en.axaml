  <x:String x:Key="String.State.Listening.Title">Ready for a meeting</x:String>
  <x:String x:Key="String.State.Listening.Description">isTranscribe watches audio and active applications. It asks for permission before recording.</x:String>
  <x:String x:Key="String.State.Suspected.Title">Checking meeting signals</x:String>
  <x:String x:Key="String.State.Suspected.Description">Conversation audio appeared. isTranscribe is gathering a few more signals before asking about recording.</x:String>
  <x:String x:Key="String.State.AwaitingConfirmation.Title">Your decision is needed</x:String>
  <x:String x:Key="String.State.AwaitingConfirmation.Description">The question is open nearby. The meeting will be skipped without an answer.</x:String>
  <x:String x:Key="String.State.Recording.Title">Recording</x:String>
  <x:String x:Key="String.State.Recording.Description">Meeting audio is being saved locally on this device.</x:String>
  <x:String x:Key="String.State.Processing.Title">Preparing the recording</x:String>
  <x:String x:Key="String.State.Processing.Description">isTranscribe is saving and compressing audio. You can close this window.</x:String>
