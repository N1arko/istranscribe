  <x:String x:Key="String.Transcription.Action.DeleteKey">Удалить сохранённый ключ</x:String>
  <x:String x:Key="String.Transcription.Action.RefreshModels">Обновить модели</x:String>
  <x:String x:Key="String.Transcription.Action.OpenPolicy">Открыть политику сервиса</x:String>
