  <x:String x:Key="String.Brand.Name">isTranscribe</x:String>
  <x:String x:Key="String.Brand.Tagline">Локальная запись встреч</x:String>
  <x:String x:Key="String.Brand.WindowTitle">isTranscribe — запись встреч</x:String>
