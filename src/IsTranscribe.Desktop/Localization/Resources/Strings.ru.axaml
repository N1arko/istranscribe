  <x:String x:Key="String.Transcription.Action.CancelModelDownload">Остановить загрузку</x:String>
  <x:String x:Key="String.Transcription.Action.RemoveModel">Удалить модель</x:String>
  <x:String x:Key="String.Transcription.Action.ContinueOnBattery">Продолжить сейчас</x:String>

  <x:String x:Key="String.Recent.Title">Последние записи</x:String>
  <x:String x:Key="String.Recent.All">Все записи</x:String>
