<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- @spec spec://modules/platform/INFRA-007-cross-platform-core-and-avalonia-shell#windows-adapters -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IsTranscribe.Platform.Windows</RootNamespace>
    <AssemblyName>IsTranscribe.Platform.Windows</AssemblyName>
    <WindowsSdkNetRefVersion>10.0.26100.84</WindowsSdkNetRefVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IsTranscribe.Core\IsTranscribe.Core.csproj" />
    <ProjectReference Include="..\IsTranscribe.Application\IsTranscribe.Application.csproj" />
    <ProjectReference Include="..\IsTranscribe.Persistence\IsTranscribe.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- @spec spec://modules/app/FEAT-011-meeting-detection-v2#signal-model -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <!-- @spec spec://modules/platform/INFRA-005.A-production-windows-x64-installer#scope.in -->
    <!-- NET.Ref is a DotnetPlatform pack: ExcludeAssets avoids NU1213 on the generic net10.0 boundary;
         the explicit references below consume its stable projection and keep it in release inventory. -->
    <PackageReference Include="Microsoft.Windows.SDK.NET.Ref" Version="$(WindowsSdkNetRefVersion)" ExcludeAssets="all" />
    <!-- @spec spec://modules/platform/INFRA-005.C-deterministic-third-party-notices#decisions.payload -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\$(WindowsSdkNetRefVersion)\lib\net8.0\Microsoft.Windows.SDK.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\$(WindowsSdkNetRefVersion)\lib\net8.0\WinRT.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
